# Phase 0 placeholder configuration.
# Values become active as their corresponding phases are implemented.

APP_ENV=development
APP_NAME=enterprise-agent-runtime-platform
API_HOST=0.0.0.0
API_PORT=8000

# Phase 1+
DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/agent_runtime
REDIS_URL=redis://redis:6379/0

# Phase 3+
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Phase 6/7+
WORKSPACE_ROOT=/data/workspaces
SANDBOX_IMAGE=enterprise-agent-runtime-sandbox:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_TIMEOUT_SECONDS=60

# Phase 9+
CONTEXT_TOKEN_BUDGET=32768

# Security
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
