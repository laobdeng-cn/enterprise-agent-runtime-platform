# Copy this file to .env for local Docker Compose overrides.
# Never commit real credentials.

APP_ENV=development

POSTGRES_DB=agent_runtime
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_PORT=5432

REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Phase 2 — Authentication / RBAC
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional local bootstrap administrator.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Phase 3 — Model Provider / Agent Harness
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

# Phase 6/7+
WORKSPACE_ROOT=/data/workspaces
WORKSPACE_MAX_FILE_BYTES=5242880
WORKSPACE_QUOTA_BYTES=52428800
DOCKER_HOST=tcp://docker:2375
DOCKER_API_VERSION=1.45
SANDBOX_IMAGE=enterprise-agent-runtime-sandbox:0.7.0
SANDBOX_BUILD_CONTEXT=/sandbox-image
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_PIDS_LIMIT=64
SANDBOX_TMPFS_MB=64
SANDBOX_MAX_OUTPUT_BYTES=262144
SANDBOX_MAX_ARTIFACTS=20
SANDBOX_MAX_CODE_BYTES=102400

# Phase 9 — Context Engineering
CONTEXT_TOKEN_BUDGET=32768
CONTEXT_RESERVED_OUTPUT_TOKENS=4096
CONTEXT_RUNTIME_RESERVE_TOKENS=4096
CONTEXT_ADDITIONAL_TOKENS=8192
CONTEXT_MEMORY_TOKENS=6144
CONTEXT_SKILL_TOKENS=4096
CONTEXT_SKILL_LIMIT=8
CONTEXT_ITEM_MAX_TOKENS=2048
CONTEXT_FALLBACK_SKILL_COUNT=3

# Phase 8 Memory
MEMORY_CONTEXT_LIMIT=8
MEMORY_SEARCH_CANDIDATE_LIMIT=200
MEMORY_SEARCH_MIN_SCORE=0.12
MEMORY_DEFAULT_TTL_DAYS=0
