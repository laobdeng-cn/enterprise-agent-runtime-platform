# Copy this file to .env for local Docker Compose overrides.
# Never commit real credentials.

APP_ENV=development

POSTGRES_DB=agent_runtime
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_PORT=5432

REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Phase 2 — Authentication / RBAC
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional local bootstrap administrator.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Phase 3 — Model Provider / Agent Harness
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

# Phase 6/7+
WORKSPACE_ROOT=/data/workspaces
SANDBOX_IMAGE=enterprise-agent-runtime-sandbox:latest
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_TIMEOUT_SECONDS=60

# Phase 9+
CONTEXT_TOKEN_BUDGET=32768
